# Telegram API credentials — get them at https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=

# Where originals are stored:
#   me                  -> your Saved Messages (zero setup, default)
#   @mychannel          -> a channel by username
#   -1001234567890      -> a private channel by ID (add your account to it first)
TG_CHANNEL=me
