<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- allow plain HTTP to self-hosted backends (LAN IPs / localhost);
         the app connects to the user's own server which is usually http:// -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
